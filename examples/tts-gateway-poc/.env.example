# Copy to `.env` and fill in, or just `export` these in your shell.
# The POC client reads these from the environment — never hardcode secrets.

# Base URL of the TTS gateway (this is also the built-in default).
TTS_API_BASE_URL=http://127.0.0.1:8123/api/v1/tts

# Bearer token. Must match `tts_api_key` in Studio settings.
# Leave unset if the server is running open (no key configured).
TTS_API_KEY=
