{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "studio_tts_manifest": "1.0",
  "engine_id": "xtts",
  "display_name": "XTTS (Local)",
  "version": "1.0.0",
  "min_studio": "2.0.0",
  "entry_class": "engine:XttsPlugin",
  "app_adapter_class": "XttsVoiceEngine",
  "capabilities": ["synthesis", "preview", "voice_cloning"],
  "worker_logic": {
    "engine_handlers": {
      "xtts": "adapter:xtts_dispatch_adapter"
    },
    "kind_handlers": {
      "voice_build": "voice_adapter:voice_job_dispatch_adapter",
      "voice_test": "voice_adapter:voice_job_dispatch_adapter",
      "voice_task": "voice_adapter:voice_job_dispatch_adapter"
    }
  },
  "behavior": {
    "features": [
      "script_synthesis",
      "batch_synthesis",
      "voice_cloning",
      "standard_rendering",
      "segment_rendering",
      "bake_rendering",
      "mixed_rendering",
      "sanitize_text",
      "cps_eta",
      "segment_orchestration"
    ],
    "required_settings": [],
    "setting_aliases": {},
    "synthesis_settings": ["temperature", "repetition_penalty", "top_k", "top_p"],
    "text_chunk_limit": 500,
    "text_split_target": 450
  },
  "local": true,
  "cloud": false,
  "network": false,
  "languages": ["en", "es", "fr", "de", "it", "pt", "pl", "tr", "ru", "nl", "cs", "ar", "zh"],
  "resource": {
    "gpu": true,
    "vram_mb": 4000,
    "cpu_heavy": true
  },
  "author": "Coqui AI",
  "homepage": "https://github.com/coqui-ai/TTS",
  "license": "CPML-1.0",
  "test_sample": "sample.wav",
  "test_text": "Hello, this is a verification test of the XTTS synthesis engine."
}
