{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiobook.studio/specs/voice.schema.json",
  "title": "Audiobook Studio Voice Bundle (voice.json)",
  "description": "Canonical, engine-agnostic voice spec. See design-docs/plans/v2_huggingface_voice_repo_spec.md and design-docs/plans/v2_voice_tag_taxonomy.md.",
  "type": "object",
  "required": ["spec", "spec_version", "id", "name", "image", "samples", "languages", "attributes"],
  "additionalProperties": false,
  "properties": {
    "spec": { "const": "audiobook-studio-voice" },
    "spec_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "taxonomy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Must match the bundle folder name." },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "image": { "type": "string", "description": "Relative path to a 1:1 image, e.g. icon.png." },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "text": { "type": "string" },
          "primary": { "type": "boolean" }
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "description": "BCP-47, e.g. en-US. First is primary." }
    },
    "attributes": {
      "type": "object",
      "required": ["class", "gender", "age"],
      "additionalProperties": false,
      "properties": {
        "class": { "enum": ["human", "synthetic", "creature", "character", "deity"] },
        "gender": { "enum": ["feminine", "masculine", "neutral", "ambiguous", "not-applicable"] },
        "age": { "enum": ["child", "teen", "young-adult", "adult", "middle-aged", "senior", "ageless"] },
        "accent": {
          "enum": ["none", "us-general", "us-southern", "us-nyc", "us-midwest", "us-african-american",
            "british-rp", "british-cockney", "british-northern", "scottish", "irish", "welsh",
            "australian", "new-zealand", "canadian", "south-african", "indian", "caribbean",
            "european", "other"]
        },
        "tone": {
          "type": "array",
          "items": { "enum": ["warm", "friendly", "calm", "soothing", "cheerful", "upbeat", "energetic",
            "confident", "authoritative", "professional", "serious", "somber", "dramatic", "intense",
            "epic", "mysterious", "menacing", "sinister", "playful", "quirky", "sarcastic", "deadpan",
            "gentle", "wise", "sensual", "melancholic", "heroic", "villainous"] }
        },
        "timbre": {
          "type": "array",
          "items": { "enum": ["deep", "low", "high-pitched", "bright", "rich", "resonant", "booming",
            "smooth", "velvety", "silky", "clear", "crisp", "soft", "breathy", "husky", "raspy",
            "gravelly", "gritty", "rough", "nasal", "thin", "light", "robotic", "distorted"] }
        },
        "pace": { "enum": ["slow", "measured", "moderate", "brisk", "fast", "variable"] },
        "use_case": {
          "type": "array",
          "items": { "enum": ["audiobook", "narration", "character-dialogue", "storytelling",
            "documentary", "e-learning", "meditation", "news", "podcast", "advertising", "gaming",
            "animation", "assistant", "ivr"] }
        },
        "quality": {
          "type": "array",
          "items": { "enum": ["studio-quality", "clean", "denoised", "hi-fi", "phone-quality",
            "vintage", "multilingual", "expressive", "fast-inference"] }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "engines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["engine_id", "asset_type", "path"],
        "additionalProperties": false,
        "properties": {
          "engine_id": { "type": "string" },
          "asset_type": { "type": "string" },
          "path": { "type": "string" },
          "min_engine_version": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": { "enum": ["recorded", "cloned", "imported", "designed"] },
        "author": { "type": "string" },
        "consent_ack": { "type": "boolean" },
        "created_at": { "type": "string" }
      }
    },
    "license": { "type": "string" }
  }
}
